{
  "name": "ml-code-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI/ML/DL 알고리즘을 라이브러리 없이 직접 구현하게 하는 온라인 저지 플랫폼 (Phase 1)",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tools/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "check:boundaries": "node tools/check-boundaries.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env tools/migrate.js up",
    "db:status": "node --env-file-if-exists=.env tools/migrate.js status",
    "db:reset": "node --env-file-if-exists=.env tools/migrate.js reset",
    "bench:submit": "node --env-file-if-exists=.env tools/bench-submit.js",
    "judge": "node tools/judge-cli.js",
    "judge:image": "docker build -t mlca-python:3.11 judge/image",
    "judge:fixtures": "node tools/judge-fixtures.js",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @mlca/web run dev",
    "dev:api": "pnpm --filter @mlca/api run dev",
    "dev:worker": "pnpm --filter @mlca/worker run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mlca/shared": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "pg": "^8.22.0",
    "typescript": "^5.9.3"
  }
}
