{
  "name": "ml-code-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI/ML/DL 알고리즘을 라이브러리 없이 직접 구현하게 하는 온라인 저지 플랫폼 (Phase 1)",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "check:boundaries": "node tools/check-boundaries.js",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @mlca/web run dev",
    "dev:api": "pnpm --filter @mlca/api run dev",
    "dev:worker": "pnpm --filter @mlca/worker run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "typescript": "^5.9.3"
  }
}
