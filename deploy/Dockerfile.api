# API 이미지.
#
# 워커는 여기 없다. 워커는 Docker 소켓이 필요해 호스트 프로세스로 돈다 (deploy/README.md).
#
# 멀티스테이지인 이유는 크기가 아니라 **런타임에 빌드 도구를 남기지 않기 위해서**다.
# 이 컨테이너는 사용자 코드를 실행하지 않지만, 신뢰 경계 안쪽이라고 해서 컴파일러를
# 넣어 둘 이유는 없다.

# --- 빌드 -------------------------------------------------------------------
FROM node:22-alpine AS build

# corepack 이 packageManager 필드를 읽어 정확한 pnpm 버전을 쓴다. 이미지가 락파일과
# 다른 pnpm 을 쓰면 --frozen-lockfile 이 통과해도 트리가 달라질 수 있다.
RUN corepack enable

WORKDIR /src

# 락파일 계층을 먼저 복사해 의존성 캐시가 소스 변경에 무효화되지 않게 한다.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/

# `--filter` 로 api 와 그 의존만 설치한다. web 의 vite·react 를 API 이미지에
# 끌어들이지 않는다.
RUN pnpm install --frozen-lockfile --filter @mlca/api...

COPY packages/shared packages/shared
COPY apps/api apps/api

# 배포에는 devDependency 가 필요 없다. 타입체크·린트는 CI 가 이미 했다.
#
# 필터가 위(`@mlca/api...`)와 다르다. 설치는 의존까지 포함해야 하지만 `deploy` 는
# **프로젝트 하나**만 받는다 — 워크스페이스 의존은 deploy 가 알아서 `/out` 안으로
# 실체화한다.
RUN pnpm --filter @mlca/api deploy --prod --legacy /out

# --- 런타임 -----------------------------------------------------------------
FROM node:22-alpine AS runtime

# node 이미지의 기본 사용자. root 로 돌 이유가 없다.
USER node
WORKDIR /app

COPY --from=build --chown=node:node /out /app

ENV NODE_ENV=production
# 컨테이너 안에서 127.0.0.1 에 바인딩하면 프록시가 닿지 못한다. 외부 노출은
# compose 가 포트를 열지 않는 것으로 막는다 — caddy 만 이 포트에 닿는다.
ENV API_HOST=0.0.0.0
ENV API_PORT=3000

EXPOSE 3000

# 헬스체크를 이미지에 둔다. compose 에만 두면 다른 방식으로 띄웠을 때 사라진다.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/index.js"]
