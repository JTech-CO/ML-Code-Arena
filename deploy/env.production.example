# 운영 `.env` 서식 — 저장소 루트에 `.env` 로 복사해 값을 채운다.
#
# **값을 채운 파일은 커밋하지 않는다** (INV-1). `.gitignore` 가 막고 CI 가 확인한다.
# 이 파일은 서식이므로 값이 비어 있어야 하며, 비어 있는지도 CI 가 확인한다.
#
# 호스트의 워커와 컨테이너의 api 가 **같은 파일**을 읽는다. 그래서 아래 주소는
# 호스트 기준이고, 컨테이너 안에서 달라져야 하는 값은 compose 가 덮어쓴다.

# --- 시크릿 (반드시 서로 다른 값) -------------------------------------------
# 같은 값을 쓰면 세션이 유출됐을 때 IP 해시가 함께 역산 가능해진다. API 가 기동 시
# 같은지 확인하고 거부한다.
#   openssl rand -base64 48
SESSION_SECRET=
IP_HASH_SECRET=

# --- 데이터베이스 ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 호스트 기준 주소. 워커·마이그레이션·백업 도구가 이 값을 쓴다.
# api 컨테이너용 주소는 compose 가 `postgres:5432` 로 덮어쓴다.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- 채점 -------------------------------------------------------------------
JUDGE_IMAGE=mlca-python:3.11
# 제출 작업 디렉터리. 워커가 호스트 프로세스이므로 호스트 절대경로다.
JUDGE_WORK_DIR=/var/lib/mlca/judge-work
WORKER_CONCURRENCY=4

# --- 배포 -------------------------------------------------------------------
NODE_ENV=production
# 도메인을 주면 Caddy 가 인증서를 자동 발급한다. 비워 두면 http://localhost 다.
# 인증서 만료 알림 주소는 여기가 아니라 `deploy/Caddyfile` 에 직접 적는다 (그 파일 주석 참조).
MLCA_SITE_ADDRESS=
# 이미지 태그. 롤백은 이 값을 이전 커밋 SHA 로 되돌리고 다시 올리는 것이다.
MLCA_TAG=

# --- 운영 -------------------------------------------------------------------
# `IE` 비율이 임계를 넘으면 이 주소로 POST 한다. 비워 두면 로그와 종료 코드로만 알린다.
ALERT_WEBHOOK_URL=
