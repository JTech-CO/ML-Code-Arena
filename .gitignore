# --- 시크릿 (INV-1) ---
.env
.env.*
!.env.example

# --- 의존성 ---
node_modules/
.pnpm-store/

# --- 빌드 산출물 (INV-2) ---
dist/
build/
*.tsbuildinfo
.vite/
coverage/

# --- 테스트 데이터 (INV-2) ---
# 케이스는 generator.py / reference.py 로 재생성한다 (INV-10)
problems/*/cases/
judge/fixtures/problems/*/cases/

# --- 채점 작업 디렉터리 ---
# 제출 원문이 잠시 머무는 곳이다. 남기지 않는다.
.judge-work/

# --- Python (judge/) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- 로그·임시 ---
*.log
npm-debug.log*
pnpm-debug.log*
.tmp/
tmp/

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- 백업 산출물 (INV-2) ---
# 덤프는 크고 개인정보를 담는다. 저장소에 두지 않는다.
backup/
deploy/backup/
*.sql.gz
